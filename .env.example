# GMLC environment. Copy to .env; never commit .env.
# The database and governance settings are enough for the Le API alone; the
# Diameter block is what lets a request reach an HSS and an MME.

DB_PASSWORD=

GMLC_PORT=8082
GMLC_DB_URL=jdbc:postgresql://localhost:5433/gmlc
GMLC_DB_USER=gmlc
GMLC_DB_PASSWORD=
GMLC_DB_POOL=10

# Operator key for POST /v1/admin/clients, which mints API keys. Leave it
# empty to disable the admin API entirely (it then answers 404). Supply it per
# deployment; never commit a value.
GMLC_ADMIN_KEY=

# Key for the subscriber pseudonym (HMAC-SHA256). Empty means unkeyed SHA-256,
# which is acceptable in development and is logged as a warning on every start.
# Set a long random value in any deployment that holds real subscriber data.
GMLC_SUBJECT_PEPPER=

# Allow EMERGENCY requests to proceed without stored consent. Off by default;
# every use is audited with the basis EMERGENCY_OVERRIDE.
GMLC_EMERGENCY_OVERRIDE=false

# Diameter identity of this GMLC. The origin host must resolve to this node in
# the DRA's configuration; the realm is usually the operator's Diameter domain.
GMLC_DIAMETER_ORIGIN_HOST=gmlc.hamiltel.local
GMLC_DIAMETER_ORIGIN_REALM=hamiltel.local

# The DRA or HSS/MME this GMLC sends SLh and SLg to. Leave peer-host empty to
# keep signalling disabled: every location request then fails closed with
# SIGNALLING_NOT_CONFIGURED instead of waiting on a socket.
GMLC_DIAMETER_PEER_HOST=
GMLC_DIAMETER_PEER_PORT=3868
GMLC_DIAMETER_TIMEOUT_MS=5000
