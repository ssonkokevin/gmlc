# GMLC environment. Copy to .env; never commit .env.
# The database and governance settings are enough for the Le API alone; the
# Diameter block is what lets a request reach an HSS and an MME.

DB_PASSWORD=

GMLC_PORT=8082
GMLC_DB_URL=jdbc:postgresql://localhost:5433/gmlc
GMLC_DB_USER=gmlc
GMLC_DB_PASSWORD=
GMLC_DB_POOL=10

# Operator key for POST /v1/admin/clients, which mints API keys. Leave it
# empty to disable the admin API entirely (it then answers 404). Supply it per
# deployment; never commit a value.
GMLC_ADMIN_KEY=

# Key for the subscriber pseudonym (HMAC-SHA256). Empty means unkeyed SHA-256,
# which is acceptable in development and is logged as a warning on every start.
# Set a long random value in any deployment that holds real subscriber data.
GMLC_SUBJECT_PEPPER=

# Allow EMERGENCY requests to proceed without stored consent. Off by default;
# every use is audited with the basis EMERGENCY_OVERRIDE.
GMLC_EMERGENCY_OVERRIDE=false

# Name the serving network sees as the LCS client (LCS-ClientID). It is not
# the API caller and never contains a subscriber identifier.
GMLC_LCS_CLIENT_NAME=GMLC

# Diameter identity of this GMLC. The origin host must resolve to this node in
# the DRA's configuration; the realm is usually the operator's Diameter domain.
GMLC_DIAMETER_ORIGIN_HOST=gmlc.local
GMLC_DIAMETER_ORIGIN_REALM=local

# The DRA or HSS/MME this GMLC sends SLh and SLg to. Leave peer-host empty to
# keep signalling disabled: every location request then fails closed with
# SIGNALLING_NOT_CONFIGURED instead of waiting on a socket. Inside the compose
# network the DRA is dra:3868 and the MME's SLg listener is custom-mme:3875.
GMLC_DIAMETER_PEER_HOST=
GMLC_DIAMETER_PEER_PORT=3868
GMLC_DIAMETER_TIMEOUT_MS=5000

# Which interface answers a Le request: DIAMETER for SLh/SLg, MAP for the SS7
# face below. On the gateway's own host the core's TCP MAP listener is
# published at 2906 (map-sccp); on the compose network it is map-sccp:2905.
GMLC_LOCATION_TRANSPORT=DIAMETER

# M3UA face. Point codes are operator data and must never be committed; a zero
# local point code or an empty host leaves MAP disabled and every MAP request
# fails closed. The JVM has no SCTP provider here, so M3UA runs over TCP.
GMLC_M3UA_HOST=
GMLC_M3UA_PORT=2906
GMLC_M3UA_LOCAL_PC=0
GMLC_M3UA_REMOTE_PC=0
GMLC_M3UA_ROUTING_CONTEXT=-1
GMLC_M3UA_LOCAL_GT=
GMLC_M3UA_NI=2
GMLC_M3UA_TIMEOUT_MS=5000
GMLC_MAP_MLC_NUMBER=
GMLC_MAP_HLR_PC=0

# Operator console. LAB, BENCH or PRODUCTION labels every figure it shows.
# The first account is created only when all three bootstrap values are set;
# leave them blank and no console account exists. Never commit a password or a
# TOTP seed. The break-glass value is the SHA-256 hex of the code, never the
# code: printf '%s' "$CODE" | sha256sum
GMLC_OPS_ENVIRONMENT=LAB
GMLC_OPS_SLO_P95_MS=0
GMLC_OPS_COOKIE_SECURE=true
GMLC_OPS_SESSION_IDLE_MINUTES=15
GMLC_OPS_SESSION_ABSOLUTE_HOURS=8
GMLC_OPS_LOCKOUT_THRESHOLD=5
GMLC_OPS_LOCKOUT_MINUTES=15
GMLC_OPS_TOTP_ISSUER=GMLC
GMLC_OPS_TOTP_PERIOD_SECONDS=30
GMLC_OPS_ARGON2_MEMORY_KIB=19456
GMLC_OPS_ARGON2_ITERATIONS=2
GMLC_OPS_ARGON2_PARALLELISM=1
GMLC_OPS_BOOTSTRAP_USER=
GMLC_OPS_BOOTSTRAP_PASSWORD=
GMLC_OPS_BOOTSTRAP_TOTP_SECRET=
GMLC_OPS_BREAK_GLASS_CODE_HASH=
GMLC_OPS_ALERTS_ENABLED=true
GMLC_OPS_ALERTS_EVAL_SECONDS=60
GMLC_OPS_ALERTS_WINDOW_MINUTES=15
GMLC_OPS_ALERTS_MIN_FINISHED=10
GMLC_OPS_ALERTS_ERROR_RATE=0.25
GMLC_OPS_ALERTS_PEER_FAILURES=3
GMLC_OPS_ALERTS_CELL_GAP=1

# Geofence webhook delivery. At-least-once; the receiver deduplicates on the
# delivery id.
GMLC_WEBHOOKS_ENABLED=true
GMLC_WEBHOOKS_FLUSH_SECONDS=10
GMLC_WEBHOOKS_INITIAL_DELAY_SECONDS=15
GMLC_WEBHOOKS_TIMEOUT_SECONDS=5
GMLC_WEBHOOKS_MAX_ATTEMPTS=5
GMLC_WEBHOOKS_BATCH_SIZE=50

# Automated tracking. Schedules place ordinary governed requests on a timer, so
# the minimum interval is a floor, not a licence-aware rate. Leave the notifier
# key empty to refuse channel creation: notification secrets are sealed at rest
# with this key and cannot be stored in the clear. It must be base64 for exactly
# 32 bytes, for example the output of `openssl rand -base64 32`.
GMLC_TRACKING_SCHEDULES_ENABLED=true
GMLC_TRACKING_MIN_INTERVAL_SECONDS=300
GMLC_TRACKING_FLUSH_SECONDS=30
GMLC_TRACKING_INITIAL_DELAY_SECONDS=45
GMLC_TRACKING_TIMEOUT_SECONDS=10
GMLC_TRACKING_BATCH_SIZE=20
GMLC_TRACKING_NOTIFIER_KEY=
